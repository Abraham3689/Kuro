# ==========================================
# KURO SUITE - PRODUCTION ENVIRONMENT VARIABLES
# ==========================================

# DOMAIN & SSL CONFIGURATION
DOMAIN_NAME=aeorost.org
CADDY_ADMIN_EMAIL=admin@aeorost.org

# SUPABASE CONFIGURATION
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# STRIPE PAYMENT & WEBHOOKS
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_PRICE_ID_CORE=price_1Q_your_core_price_id
STRIPE_PRICE_ID_PRO=price_1Q_your_pro_price_id

# KURO AFFILIATE & MSP REFERRAL PROGRAM
AFFILIATE_SERVICE_URL=http://kuro-affiliate:3000
AFFILIATE_RECURRING_COMMISSION_PERCENTAGE=15
AFFILIATE_WEBHOOK_SECRET=whsec_affiliate_secret_key

# BACKBLAZE B2 / CLOUDFLARE R2 STORAGE CONFIGURATION
B2_BUCKET_NAME=kuro-drive-storage
B2_REGION=us-west-004
B2_KEY_ID=your-backblaze-key-id
B2_APPLICATION_KEY=your-backblaze-application-key
B2_ENDPOINT=s3.us-west-004.backblazeb2.com
